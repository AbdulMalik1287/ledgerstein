# Copy to .env and fill in. Never commit .env.
# Tier 4 needs exactly one of these. Set none and the adjudicator skips the
# ambiguous rows and logs why, which is the safe default.
#   anthropic  paid          console.anthropic.com
#   gemini     free, no card aistudio.google.com/apikey
#   groq       free, no card console.groq.com/keys
#   ollama     free, local   no key at all -- just run a model locally
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: force a backend instead of taking the first key that is set.
# Local fallback. No key; used only when no hosted key is set and the server
# answers. Defaults shown.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

LEDGERSTEIN_PROVIDER=auto
LEDGERSTEIN_MODEL=
LEDGERSTEIN_DB_URL=sqlite:///./ledgerstein.sqlite3
LEDGERSTEIN_LLM_ENABLED=true
